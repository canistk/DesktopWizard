packages/
*.nupkg
*.snupkg
.nuget/

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml

# Cache files
*.cache
*.cachefile
*.VC.db
*.VC.VC.opendb

# Others
*.publishsettings
orleans.codegen.cs
